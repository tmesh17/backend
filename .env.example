# Supabase configuration
SUPABASE_URL=https://gsyzkwxcsdcddwvkngpq.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_DISCOVERY_URL=https://gsyzkwxcsdcddwvkngpq.supabase.co/auth/v1/.well-known/jwks.json

# College Scorecard API key (optional)
# Get a free key from: https://api.data.gov/signup/
# Uncomment and set to enable importing ~7,000 colleges from the API
# SCORECARD_API_KEY=your-api-key-here

# Database
DATABASE_URL=sqlite:///./collegescore.db

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Feature flags
USE_TEST_TABLES=false
EXPOSE_REVIEW_IDENTITIES=true
