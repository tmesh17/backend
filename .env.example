# Supabase configuration
SUPABASE_URL=https://gsyzkwxcsdcddwvkngpq.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_DISCOVERY_URL=https://gsyzkwxcsdcddwvkngpq.supabase.co/auth/v1/.well-known/jwks.json

# Real Data API Keys (REQUIRED for real data integration)

# Census Bureau API key (REQUIRED for city demographics)
# Free registration: https://api.census.gov/data/key_signup.html
# Takes 5 minutes, instant activation
CENSUS_API_KEY=your-api-key-here

# College Scorecard API key (OPTIONAL - improves rate limits)
# Free registration: https://api.data.gov/signup/
SCORECARD_API_KEY=your-api-key-here

# Database
DATABASE_URL=sqlite:///./collegescore.db

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Feature flags
USE_TEST_TABLES=false
EXPOSE_REVIEW_IDENTITIES=true
