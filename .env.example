# Supabase JWT secret (found in Supabase project settings > API > JWT Secret)
# Required for POST /v0/reviews to verify the auth token from the frontend
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Database URL (SQLite for local dev, can switch to Postgres for prod)
DATABASE_URL=sqlite:///./collegescore.db

# CORS origins (frontend URL)
FRONTEND_URL=http://localhost:3000
